@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix ex:  <http://example.org/> .

<http://example.org/onto> a owl:Ontology .

ex:F a owl:Class ;
     owl:disjointUnionOf ( ex:A ex:B ) .
ex:A a owl:Class .
ex:B a owl:Class .

# An F with no contradiction: neither asserted to be neither A nor B,
# nor asserted to be both A and B. Must remain consistent after the
# same lowering that makes covering.ttl and covering-both.ttl
# inconsistent, otherwise the lowering itself would be the source of
# the inconsistency rather than a genuine covering/disjointness
# violation.
ex:x a ex:F .
